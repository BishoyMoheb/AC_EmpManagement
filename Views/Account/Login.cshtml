@model VM_Login

@{
    ViewBag.Title = "Login Page";
}

<div class="row">

    <div class="col-md-6">

        <h1>User Login</h1>

        <form method="post">

            <div asp-validation-summary="All" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <div class="form-check">
                    <label asp-for="RememberMe">
                        <input asp-for="RememberMe" />
                        @Html.DisplayNameFor(m => m.RememberMe)
                    </label>
                </div>
            </div>

            <button type="submit" class="btn btn-primary">Login</button>

            @*Add ForgotPassword Part*@
            <div>
                <a asp-action="ForgotPassword">Forgot Password</a>
            </div>

        </form>

    </div>

    <div class="col-md-6">

        <h1>External LogIN</h1>
        <hr />
        @{ 
            if(Model.L_AS_ExternalLoginI.Count==0)
            {
                <div>No external logins is configured</div>
            }
            else
            {
                <form method="post" asp-action="External_LogIN" asp-route-returnUrl="@Model.ReturnURL">
                    @foreach(var LoginProvider in Model.L_AS_ExternalLoginI)
                    {
                        <button type="submit" class="btn btn-primary" style="width:auto"
                                name="loginProvider" value="@LoginProvider.Name"
                                title="LogIN using @LoginProvider.DisplayName account">
                            @LoginProvider.DisplayName
                        </button>
                    }
                </form>
            }
        }

    </div>

</div>
