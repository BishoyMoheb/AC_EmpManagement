@model MEmployee

@{ 
    ViewBag.Title = "Create New Employee";
}

    <form asp-controller="Home" asp-action="Create" method="post">

        <div class="form-group row">
            <label asp-for="Name" class="col-sm-2 col-form-label">Name</label>
            <div class="col-sm-10">
                <input asp-for="Name" class="form-control" placeholder="Name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Email" class="col-sm-2 col-form-label">Email</label>
            <div class="col-sm-10">
                <input asp-for="Email" class="form-control" placeholder="Email" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
        </div>

        <div class="form-group row">
            <label asp-for="Department" class="col-sm-2 col-form-label">Department</label>
            <div class="col-sm-10">
                <select asp-for="Department"
                        asp-items="Html.GetEnumSelectList<EnumDept>()"
                        class="custom-select mr-sm-2">
                    <option>Choose</option>
                    @*<option value="">Choose</option>*@
                </select>
                <span asp-validation-for="Department" class="text-danger" ></span>
            </div>
        </div>

        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group row">
            <div class="col-sm-10">
                <input type="submit" value="Create" class="btn btn-primary"/>
            </div>
        </div>
    </form> 
