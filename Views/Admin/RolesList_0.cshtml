@model IEnumerable<IdentityRole>

@{
    ViewBag.Title = "Roles List";
}

<h1>Listing the Roles</h1>

@if (Model.Any())
{
    <a class="btn btn-primary mb-3" style="width:auto"
       asp-controller="Admin" asp-action="CreateRole">Add new role</a>

    foreach (var IDRole_Item in Model)
    {
        <div class="card m-3">
            <div class="card-header">
                <h3>Role ID : @IDRole_Item.Id</h3>
            </div>
            <div class="card-body">
                <h5 class="card-title">@IDRole_Item.Name</h5>
            </div>
            <div class="card-footer">
                <a class="btn btn-primary" asp-controller="Admin" 
                   asp-action="EditRole" asp-route-Id="@IDRole_Item.Id">Edit</a>
                <a href="#" class="btn btn-danger">Delete</a>
            </div>
        </div>
    }
}
else
{
    <div class="card">
        <div class="card-header">
            <h3>No role(s) exists</h3>
        </div>
        <div class="card-body">
            <h5 class="card-title">
                Use the button below to create a role
            </h5>
            <a class="btn btn-primary" style="width:auto"
               asp-controller="Admin" asp-action="CreateRole">
                Create Role
            </a>
        </div>
    </div>
}
