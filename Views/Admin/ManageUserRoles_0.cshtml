@model List<VM_User_WithRoles>

@{
    ViewBag.Title = "Manage User Roles";
    var UserId = ViewBag.UId;
}

<h1>Managing User with his Roles</h1>

<form method="post">
    <div class="card">
        <div class="card-header">
            <h3>Roles with a User</h3>
        </div>
        <div class="card-body">
            @foreach (var vmUserWRoles_Item in Model)
            {
                <div class="form-check m-1">
                    <input type="hidden" asp-for="@vmUserWRoles_Item.RoleId" />
                    <input type="hidden" asp-for="@vmUserWRoles_Item.RoleName" />
                    <input asp-for="@vmUserWRoles_Item.IsSelected" class="form-check-input"/>
                    <label class="form-check-label" asp-for="@vmUserWRoles_Item.IsSelected">
                        @vmUserWRoles_Item.RoleName
                    </label>
                </div>
            }
            <div asp-validation-summary="All" class="text-danger"></div>
        </div>
        <div class="card-footer">
            <input type="submit" value="Update" class="btn btn-primary" style="width:auto"/>
            <a asp-controller="Admin" asp-action="EditUsers" asp-route-Id="@UserId"
               class="btn btn-primary" style="width:auto">Cancel</a>
        </div>
    </div>
</form>