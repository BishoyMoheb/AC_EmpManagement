@model VM_EditUser

@{
    ViewBag.Title = "Edit Users";
}

<h1>Editting the Users</h1>

<form method="post" class="mt-3">

    <div class="form-group row">
        <label asp-for="Id" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Id" disabled class="form-control" />
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="UserName" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="UserName" class="form-control" />
            <span asp-validation-for="UserName" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="Email" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="Email" class="form-control" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>
    </div>

    <div class="form-group row">
        <label asp-for="City" class="col-sm-2 col-form-label"></label>
        <div class="col-sm-10">
            <input asp-for="City" class="form-control" />
            <span asp-validation-for="City" class="text-danger"></span>
        </div>
    </div>

    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="form-group row">
        <div class="col-sm-10">
            <button type="submit" class="btn btn-primary">Update</button>
            <a asp-controller="Admin" asp-action="UsersList"
               class="btn btn-primary">Cancel</a>
        </div>
    </div>

    <br />
    <br />

    <div class="card">
        <div class="card-header">
            <h3>Users Roles</h3>
        </div>
        <div class="card-body">
            @if (Model.L_URolesI.Any())
            {
                foreach (var RoleItem in Model.L_URolesI)
                {
                    <h5 class="card-title">@RoleItem</h5>
                }
            }
            else
            {
                <h5 class="card-title">None at the moment</h5>
            }
        </div>
        <div class="card-footer">
            <a href="#" style="width:auto" class="btn btn-primary">
                Manage Roles
            </a>
        </div>
    </div>

    <div class="card">
        <div class="card-header">
            <h3>Users Claims</h3>
        </div>
        <div class="card-body">
            @if (Model.L_UClaims.Any())
            {
                foreach (var ClaimItem in Model.L_UClaims)
                {
                    <h5 class="card-title">@ClaimItem</h5>
                }
            }
            else
            {
                <h5 class="card-title">None at the moment</h5>
            }
        </div>
        <div class="card-footer">
            <a href="#" style="width:auto" class="btn btn-primary">
                Manage Claims
            </a>
        </div>
    </div>

</form>
